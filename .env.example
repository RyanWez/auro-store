# ==========================================
# AURA STORE — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_SECRET_TOKEN="optional_webhook_security_secret"

# 2. Database (Supabase PostgreSQL Connection)
DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres?sslmode=require"

# 3. Upstream Partner API
UPSTREAM_API_URL="http://paid2.daki.cc:4153/api/partner/v1"
UPSTREAM_API_KEY="your_upstream_api_key_here"

# 4. Admin Security
ADMIN_PASSWORD="set_a_strong_admin_password_here"
NEXTAUTH_SECRET="random_generated_secret_string"

# 5. Public URLs
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
